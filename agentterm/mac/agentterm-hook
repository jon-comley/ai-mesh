#!/bin/sh
# Claude's hooks and status line for a worker's terminal on this machine
# (plans/agent-terminals.md in ai-mesh). Forwards each to agentterm on lenovo1,
# which keeps what the tile shows. Installed by `just deploy-agentterm-mac`.
#
#   agentterm-hook <agent> <event> [<tick label> <pause file>]
#   agentterm-hook <agent> statusline [<status file>]
#
# With a tick label, a prompt waits for nothing: if the tick is running it is
# refused (exit 2 shows Claude the reason), else the tick is paused.
agent=$1 event=$2 label=$3 pause=$4
input=$(cat)
if [ "$event" = prompt ] && [ -n "$label" ]; then
    if launchctl list "$label" 2>/dev/null | grep -q '"PID"'; then
        echo "It is in the middle of a tick. Ask again in a minute or two." >&2
        exit 2
    fi
    if [ ! -e "$pause" ]; then
        mkdir -p "$HOME/.ai-mesh/term"
        touch "$pause" "$HOME/.ai-mesh/term/$agent.paused"
    fi
fi
case $event in
    statusline) what=statusline ;;
    *) what="hook $event" ;;
esac
# A missed update must never block the session.
printf '%s' "$input" | ssh -o BatchMode=yes -o ConnectTimeout=5 lenovo1 \
    "AGENTTERM_AGENT=$agent /usr/local/bin/agentterm $what" 2>/dev/null
# Where the worker stands, under the prompt (the third argument is its status file).
if [ "$event" = statusline ] && [ -n "$label" ] && [ -r "$label" ]; then
    grep -E '^(State|NEXT):' "$label" 2>/dev/null || head -n 1 "$label" | cut -c1-150
fi
exit 0
