[Unit]
Description=ai-mesh Coordinator (lighting + cluster management)
Documentation=https://github.com/grazfather/ai-mesh
Requires=network-online.target
After=network-online.target

[Service]
Type=simple
User=jonno
Group=jonno

WorkingDirectory=/var/lib/ai-mesh
ExecStart=/usr/local/bin/ai-mesh-coordinator
Restart=always
RestartSec=5s

# Environment
Environment="RUST_LOG=info"
# No MDNS_ADVERTISE_IP: the coordinator auto-detects its outbound LAN IP (see mdns.rs),
# so it advertises correctly on whatever subnet pi1 is on. Set this env var via a
# service.d/override.conf drop-in only to force a specific advertise address.
Environment="MESH_HTTP_PORT=9001"
Environment="MESH_STATE_DIR=/var/lib/ai-mesh"

# Read coordinator.state on startup to reuse the existing token and cert/key pinning.
# State file lives under StateDirectory so no home-dir access is required.
EnvironmentFile=-/var/lib/ai-mesh/coordinator.state

# Security
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=ai-mesh

# Resource limits
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
