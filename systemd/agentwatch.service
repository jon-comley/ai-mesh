# The agent watch page on lenovo1 (plans/agent-watch.md), at http://lenovo1/.
# Installed by `just deploy-agentwatch`. Runs as jonno so it uses lenovo1's own
# ssh key to mac1; port 80 through the one capability it needs.
[Unit]
Description=Agent watch page (http://lenovo1/)
After=network-online.target
Wants=network-online.target

[Service]
User=jonno
Environment=AGENTWATCH_DIR=/home/jonno/.ai-mesh/agents
Environment=AGENTWATCH_ADDR=0.0.0.0:80
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/agentwatch
Restart=on-failure
RestartSec=10
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
