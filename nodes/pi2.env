# Pinned rather than mDNS, 2026-09-15, same as mac1 and lenovo1. `pi2.local` did
# not resolve from here or from pi1 during the rebuild, and HISTORY's 2026-07 note
# about moving these to `.local` predates the two-mesh split that made mDNS
# unreliable across it.
NODE_HOST=192.168.1.186
NODE_USER=jonno
NODE_OS=linux
NODE_ROLE=controller
NODE_FEATURES=art,audio,music
AUDIO_BACKENDS=hdmi,bluetooth
ART_MATTE_PERCENT=5
ART_FRAME_THICKNESS=3
ART_SIDE_MARGIN_BOOST=14
ART_GLAZE_PERCENT=25
ART_BRIGHTNESS_PERCENT=80
ART_BORDER_GLAZE_PERCENT=75
SPOTIFY_DEVICE_NAME="AI Mesh"
# Rebuilt 2026-09-15 on Raspberry Pi OS Lite 64-bit (Debian 13 trixie) after the
# SD card failed — 4 green flashes, start.elf found but not launched. The node had
# been off the mesh since roughly 15 August and nothing noticed, because the only
# thing that knew was a "last seen 45,140m" column in `just nodes`.
#
# On the Velop (`toob-5B7875`) at about -76 dBm, NOT on ORBI40 where pi1 is. Not a
# password problem: the PSK was copied from pi1's live profile and verified
# identical by hash on both boxes. pi2 associates and the Orbi drops it at the
# 4-way handshake, which points at Access Control on the Orbi rather than the key.
# Worth moving once that is settled — pi1 is the coordinator and same-mesh would
# take this hop out of the cross-AP fault `infrastructure/network.md` documents.
COORDINATOR_IP=192.168.1.103
