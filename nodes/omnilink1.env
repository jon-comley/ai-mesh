NODE_HOST=127.0.0.1
NODE_USER=jonno
NODE_OS=linux
NODE_ROLE=controller
NODE_FEATURES=reaper
# Pinned, 2026-09-15, same as mac1.env and lenovo1.env. This node's agent had
# been dialling `10.0.0.87` — pi1's address from BEFORE the move to
# 192.168.1.102 and then .103 (infrastructure/network.md's "historic addresses,
# now dead"). It was set in the systemd drop-in, which overrides the base unit,
# so the base unit's own already-stale `.102` never even got a look in.
#
# It failed silently in the worst way available: `systemctl is-active` said
# `active` and `is-enabled` said `enabled`, so every check short of reading the
# journal said the node was fine, while it timed out three times and slept for
# sixty seconds, round and round, for months. The mesh table was the only thing
# that knew, and it said "last seen 3805m" next to a row nobody was reading.
COORDINATOR_IP=192.168.1.103
