# NODE_HOST must be the LAN IP, not a .local name. `just load-model` resolves
# the node through `cli find-node`, which matches on IP alone (cli/src/commands/
# find_node.rs) — a hostname never matches, and the recipe fails after a 120s
# wait that reads like the agent is down when it is in fact connected and
# heartbeating. .116 is a DHCP reservation in the Velop, so it is stable.
NODE_HOST=192.168.1.116
NODE_USER=jonno
NODE_OS=windows
NODE_ROLE=compute
NODE_FEATURES=llm
# Windows gets no useful mDNS from pi1, so discovery finds nothing and the agent
# falls back to 127.0.0.1:9000 — reaching for the coordinator on itself, looping
# for ever while the service still reports Running. Every other non-coordinator
# node pins this; beelink1 was powered off for the BIOS flash when the rest were
# pinned on 2026-09-15 and was missed.
COORDINATOR_IP=192.168.1.103
LLAMA_GPU_LAYERS=99
STT_SERVER=true
