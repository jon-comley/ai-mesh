# Mac Studio — Apple M4 Max, 16-core CPU, 40-core GPU, 64GB unified memory.
# Added 2026-09-13 as an LLM compute node. It is also the guv iOS simulator CI
# runner; 64GB leaves plenty of room for a 5GB model beside the simulator.
#
# The agent is built ON this machine (scripts/install-node-macos.sh): Linux
# can't cross-compile a macOS binary without Apple's SDK.
NODE_HOST=192.168.1.121
NODE_USER=jonno
NODE_OS=macos
NODE_ROLE=compute
# `review`: mac1 runs the code reviews and hands tasks to the other machines
# (docs/code-review.md, 2026-10-10).
NODE_FEATURES=llm,review
# Pinned rather than discovered: the Mac and pi1 sit on different Wi-Fi meshes
# today (Velop and Orbi), and mDNS across them is not trustworthy. Revisit
# after infrastructure/orbi-switch-plan.md puts everything on one network.
COORDINATOR_IP=192.168.1.103
# 256k context for feature-sized review tasks. The review model is
# qwen3-coder-next:80b (38.4 GB, IQ4_XS): only a quarter of its layers keep a
# full attention cache, so 256k with q8_0 is about 3-4 GB — ~43-44 GB in all
# with working space, under macOS's default GPU limit (~75% of 64 GB, ~48 GB)
# and leaving ~20 GB for macOS and the iOS simulator. Load it with
# `just load-model mac1 qwen3-coder-next:80b` (docs/code-review.md).
LLAMA_CTX_SIZE=262144
LLAMA_KV_CACHE_TYPE=q8_0
# Two slots sharing one pool: a light command takes the second slot and a
# paused review keeps the prompt it had already read. Off until the bench shows
# llama.cpp b9444 accepts --kv-unified — an unknown flag stops llama-server
# from starting, which would take mac1's model down with it.
# docs/code-review.md, "Before turning it on".
#LLAMA_PARALLEL=2
#LLAMA_KV_UNIFIED=true
# Only repos from this GitHub account may be added to the review list.
REVIEW_ALLOWED_OWNERS=jon-comley
# The model that scored 7/7 on the real-prompt bench with native tool calling
# (docs/model-selection.md, 2026-09-13).
DEFAULT_MODEL=qwen3:8b
