# Mac Studio — Apple M4 Max, 16-core CPU, 40-core GPU, 64GB unified memory.
# Added 2026-09-13 as an LLM compute node. It is also the guv iOS simulator CI
# runner; 64GB leaves plenty of room for a 5GB model beside the simulator.
#
# The agent is built ON this machine (scripts/install-node-macos.sh): Linux
# can't cross-compile a macOS binary without Apple's SDK.
NODE_HOST=192.168.1.121
NODE_USER=jonno
NODE_OS=macos
NODE_ROLE=compute
NODE_FEATURES=llm
# Pinned rather than discovered: the Mac and pi1 sit on different Wi-Fi meshes
# today (Velop and Orbi), and mDNS across them is not trustworthy. Revisit
# after infrastructure/orbi-switch-plan.md puts everything on one network.
COORDINATOR_IP=192.168.1.103
LLAMA_CTX_SIZE=8192
# The model that scored 7/7 on the real-prompt bench with native tool calling
# (docs/model-selection.md, 2026-09-13).
DEFAULT_MODEL=qwen3:8b
