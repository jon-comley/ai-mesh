NODE_HOST=pi1.local
NODE_USER=jonno
NODE_OS=linux
# **Not a compute node — Jon, 2026-09-12.** It was `compute`, and on that night
# `just start-cluster` chose `deepseek-r1:7b` for it: `auto-load-model` takes the
# largest model that fits, and pi1's 6.5 GB free RAM and 9.3 GB free disk passed
# the 2x-model-size disk test by about **360 MB**. That is the SD card also
# carrying the MQTT broker, Zigbee2MQTT, the lighting and the coordinator itself,
# so filling it takes the house down rather than just the mesh. The download was
# stopped before it started.
#
# A 7B on a Pi 5 is CPU-only and glacial in any case, and this file's own
# neighbours in `justfile` say the Pi should serve `qwen2.5:1.5b` if it serves
# anything. It now serves nothing: inference belongs on beelink1, and on the Mac
# once that node exists.
#
# **It stays the coordinator.** That is a different flag (`NODE_COORDINATOR`
# below) and a different job — the registry the other nodes connect to, which
# wants an always-on box rather than a laptop that sleeps.
#
# Changing this line changes nothing on the Pi until something rewrites the
# systemd unit: `update-node` swaps the binary only, and pi1's unit still said
# `AGENT_ROLE=compute` from its original `deploy-node`. On 2026-09-13 the agent
# came back up registered as Compute, so the role is now pinned by the drop-in
# `/etc/systemd/system/ai-mesh-agent.service.d/role.conf` (`AGENT_ROLE=controller`).
NODE_ROLE=controller
NODE_COORDINATOR=true
NODE_FEATURES=llm,lighting,sensors,voice
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
ZIGBEE_HOST=10.0.0.121
VOICE_DEVICE_HOST=10.0.0.14:6053
VOICE_STT_REMOTE=beelink1.local:8081
VOICE_TTS_BASE_URL=http://pi1.local:9001
