[Unit]
Description=ai-mesh Agent (Beelink SER8 Compute Node)
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=jonno
Environment=AGENT_ROLE=compute
Environment=COORDINATOR_IP=192.168.1.12
Environment=COORDINATOR_PORT=9000
ExecStart=/home/jonno/agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
